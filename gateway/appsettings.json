{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },

  // ── JWT / Identity ────────────────────────────────────────────────────────
  "Identity": {
    "BaseUrl": "http://identity.railway.internal:7070"
  },
  "Jwt": {
    "Key": "Lani_Security_Key_2026_Identity_Service_Super_Secret_Key_Nicaragua",
    "Issuer": "Lani.Identity",
    "Audience": "Lani.Apps"
  },

  // ── CORS ─────────────────────────────────────────────────────────────────
  // En producción, reemplaza "*" con los dominios reales del frontend
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },

  // ══════════════════════════════════════════════════════════════════════════
  // YARP — Configuración del Proxy Inverso
  //
  // Convención de nombres internos Railway:
  //   http://<nombre-del-servicio-en-railway>.railway.internal:7070
  //
  // Rutas públicas (AuthorizationPolicy: "default" = requiere JWT válido)
  // Rutas de Identity (AuthorizationPolicy: "" = anónimo, para login/register)
  // ══════════════════════════════════════════════════════════════════════════
  "ReverseProxy": {

    // ── RUTAS ─────────────────────────────────────────────────────────────
    "Routes": {

      // ── Identity (público: login, register, jwks) ──────────────────────
      "identity-public-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v{version}/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v{version}/auth/{**catch-all}" }
        ]
      },
      "identity-jwks-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },

      // ── Catalog ────────────────────────────────────────────────────────
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v{version}/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v{version}/catalog/{**catch-all}" }
        ]
      },

      // ── Commerce ───────────────────────────────────────────────────────
      "commerce-route": {
        "ClusterId": "commerce-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v{version}/commerce/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v{version}/commerce/{**catch-all}" }
        ]
      },

      // ── Companies ──────────────────────────────────────────────────────
      "companies-route": {
        "ClusterId": "companies-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v{version}/companies/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v{version}/companies/{**catch-all}" }
        ]
      },

      // ── Onboarding ─────────────────────────────────────────────────────
      "onboarding-route": {
        "ClusterId": "onboarding-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v{version}/onboarding/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v{version}/onboarding/{**catch-all}" }
        ]
      },

      // ── Products ───────────────────────────────────────────────────────
      "products-route": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v{version}/products/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v{version}/products/{**catch-all}" }
        ]
      }
    },

    // ── CLUSTERS (destinos internos Railway) ─────────────────────────────
    "Clusters": {

      "identity-cluster": {
        "Destinations": {
          "identity-primary": {
            "Address": "http://identity.railway.internal:7070"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },

      "catalog-cluster": {
        "Destinations": {
          "catalog-primary": {
            "Address": "http://catalog.railway.internal:7070"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },

      "commerce-cluster": {
        "Destinations": {
          "commerce-primary": {
            "Address": "http://commerce.railway.internal:7070"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },

      "companies-cluster": {
        "Destinations": {
          "companies-primary": {
            "Address": "http://companies.railway.internal:7070"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },

      "onboarding-cluster": {
        "Destinations": {
          "onboarding-primary": {
            "Address": "http://onboarding.railway.internal:7070"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },

      "products-cluster": {
        "Destinations": {
          "products-primary": {
            "Address": "http://products.railway.internal:7070"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  }
}
